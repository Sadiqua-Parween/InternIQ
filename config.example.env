# InternIQ Environment Configuration
# Copy this file to .env and configure your local keys.

# Application Environment
ENV=development
LOG_LEVEL=INFO

# LLM Provider Configuration (Optional / Mockable)
# Supported: gemini, openai, anthropic, mock
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Storage & Persistence
SQLITE_DB_PATH=interniq.db
FAISS_INDEX_PATH=data/faiss_index.bin

# Execution Limits (per proposal Table 10 & Section 10.6)
MAX_REPLAN_ROUNDS=3
MAX_TOOL_CALLS_PER_RUN=15
MAX_REGENERATION_ATTEMPTS=2
REQUEST_TIMEOUT_SECONDS=10
